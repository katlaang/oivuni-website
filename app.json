{
  "expo": {
    "name": "Oivuni AI",
    "slug": "oivuni-ai",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#111111",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#111111",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "name": "Oivuni AI | Applied AI Research & Commercialization",
      "shortName": "Oivuni AI",
      "description": "Oivuni AI turns applied AI research into validated products that solve measurable problems.",
      "themeColor": "#111111",
      "backgroundColor": "#111111",
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-font"
    ]
  }
}
